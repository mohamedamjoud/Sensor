{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Temperature_Prod.db",
    "IntegrationTestConnection": "DataSource=Temperature_IntegrationTest.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RetrieveLatestSensorRequestsSize": "15",
  "SensorIntervals":[
    {
      "State" : "Hot",
      "Min" : "35",
      "Max" : "100"
    }, 
    {
      "State" : "Cold",
      "Min" : "-100",
      "Max" : "21"
    },
    {
      "State" : "Warm",
      "Min" : "22",
      "Max" : "34"
    }
  ],
  "AllowedHosts": "*"
}